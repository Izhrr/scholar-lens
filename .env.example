# Copy to .env and fill in OPENAI_API_KEY. Never commit .env.

# --- OpenAI (the only paid part) ---
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Hard cap on answer length; keeps every chat call cheap.
LLM_MAX_OUTPUT_TOKENS=700
LLM_TEMPERATURE=0.2

# --- PostgreSQL (docker-compose builds DATABASE_URL from these) ---
# Use letters and digits only in the password: it is placed inside a URL.
POSTGRES_USER=scholarlens
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=scholarlens

# --- Chroma ---
# Changing the embedding model requires a new collection name and re-uploading papers.
CHROMA_COLLECTION=scholarlens_paper_chunks_v1

# --- Frontend / API ---
# Baked into the frontend at build time: run `docker compose up --build` after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25

# --- Retrieval and context size (cost levers) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
BM25_TOP_K=12
DENSE_TOP_K=12
RRF_K=60
FINAL_TOP_K=6
MAX_CONTEXT_CHARS=15000
# Past question/answer pairs sent with each new question.
CHAT_HISTORY_TURNS=4

LOG_LEVEL=INFO
