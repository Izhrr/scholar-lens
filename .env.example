# ScholarLens configuration.
# Copy to .env, then fill in LLM_API_KEY and POSTGRES_PASSWORD. Never commit .env.
#
# Default setup (cheapest): DeepSeek for chat, free local model for embeddings.
# Alternatives for OpenAI and Gemini are at the bottom of this file.

# ---------------------------------------------------------------------------
# Chat model: any OpenAI-compatible API. The only call billed per question.
# ---------------------------------------------------------------------------
LLM_API_KEY=replace_with_your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# "none" turns off DeepSeek's thinking mode: cheaper and faster for cited answers.
LLM_REASONING_EFFORT=none
LLM_MAX_TOKENS_PARAM=max_tokens
# Hard cap on answer length, so no single question can get expensive.
LLM_MAX_OUTPUT_TOKENS=700
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Embeddings
# local: BAAI/bge-small-en-v1.5 runs inside the backend. Free; ~64 MB download once.
# api:   an OpenAI-compatible /embeddings endpoint, billed per token.
# Changing provider or model needs a new CHROMA_COLLECTION and re-indexing,
# because vectors from different models cannot be mixed.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Only for EMBEDDING_PROVIDER=api with a different provider than chat.
# The key falls back to LLM_API_KEY when empty.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=64

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Compose builds DATABASE_URL from these. Use letters and digits only in the
# password (it goes inside a URL), and do not change it after the first start.
POSTGRES_USER=scholarlens
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=scholarlens

CHROMA_COLLECTION=scholarlens_chunks_bge_small_v1

# ---------------------------------------------------------------------------
# Frontend and API
# ---------------------------------------------------------------------------
# Baked into the frontend at build time: run `docker compose up --build` after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------------
# Retrieval (also the cost levers: fewer/shorter passages = fewer input tokens)
# ---------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
BM25_TOP_K=12
DENSE_TOP_K=12
RRF_K=60
FINAL_TOP_K=6
MAX_CONTEXT_CHARS=15000
# Previous question/answer pairs sent with each new question.
CHAT_HISTORY_TURNS=4

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Alternatives: change the matching lines above (do not add duplicates).
#
# OpenAI for both:
#   LLM_API_KEY=your_openai_api_key
#   LLM_BASE_URL=
#   LLM_MODEL=gpt-4.1-mini
#   LLM_REASONING_EFFORT=
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_BATCH_SIZE=128
#   CHROMA_COLLECTION=scholarlens_chunks_openai_v1
#
# Gemini for both (key from https://aistudio.google.com/apikey):
#   LLM_API_KEY=your_gemini_api_key
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-3.5-flash-lite
#   LLM_REASONING_EFFORT=minimal
#   LLM_MAX_OUTPUT_TOKENS=2048
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_MODEL=gemini-embedding-001
#   EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   EMBEDDING_BATCH_SIZE=100
#   CHROMA_COLLECTION=scholarlens_chunks_gemini_v1
# ---------------------------------------------------------------------------
